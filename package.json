{
  "name": "ermiana",
  "version": "2.2.0",
  "description": "A discord bot that shows hidden description.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "discord:register": "node src/scripts/register-commands.js",
    "deploy:verify": "node test/discord-live/verify.js --preflight",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "lint": "eslint .",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/process/**/*.test.js\"",
    "test:redis": "node --test \"test/redis/**/*.test.js\"",
    "test:verify-discord": "node test/discord-live/verify.js",
    "test:smoke-discord": "node test/discord-live/smoke.js",
    "test:smoke-webhook": "node test/discord-live/webhook.js",
    "test:coverage": "node --experimental-test-coverage --test \"test/unit/**/*.test.js\" \"test/process/**/*.test.js\"",
    "check": "npm run lint && npm run test:coverage && npm run test:redis"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canaria3406/ermiana.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "author": "canaria3406",
  "license": "MIT",
  "homepage": "https://github.com/canaria3406/ermiana",
  "dependencies": {
    "cheerio": "^1.1.2",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.3",
    "pino": "^9.12.0",
    "pm2": "^7.0.3",
    "redis": "^5.8.2",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}

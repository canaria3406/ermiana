DCTK="Discord Bot token"
DCID="Discord Bot client ID"
DCWH="Discord Private Webhook URL"
BHUD="Baha id"
BHPD="Baha secret"

# Optional: Enable GNN platform emoji in embeds (default: false)
# Set to "true" or "1" to enable, anything else = disabled (pure text)
ENABLE_GNN_PLATFORM_EMOJI="false"

# Optional: GNN platform emoji IDs (only used when ENABLE_GNN_PLATFORM_EMOJI is enabled)
# These are example values; replace with your own emoji IDs if you fork this project.
GNN_EMOJI_PC="emoji_id_here"
GNN_EMOJI_PS="emoji_id_here"
GNN_EMOJI_SWITCH="emoji_id_here"
GNN_EMOJI_XBOX="emoji_id_here"

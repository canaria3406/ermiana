NODE_ENV=production
LOG_LEVEL=error
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_TOTAL_SHARDS=auto
DISCORD_WEBHOOK_URL=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=ermiana
REDIS_RETRY_INITIAL_DELAY_MS=1000
REDIS_RETRY_MAX_DELAY_MS=30000
REDIS_RETRY_BUDGET_MS=90000
GUILD_DATABASE_PATH=data/ermiana.db
CACHE_LOCK_TTL_MS=30000
CACHE_WAIT_TIMEOUT_MS=13000
HTTP_TIMEOUT_MS=5000
HTTP_RETRIES=1
SHARD_SPAWN_TIMEOUT_MS=120000
BAHA_USER_ID=
BAHA_PASSWORD=
